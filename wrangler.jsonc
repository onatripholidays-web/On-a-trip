{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "on-a-trip",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "onatripholidays.com",
      "custom_domain": true
    },
    {
      "pattern": "www.onatripholidays.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
