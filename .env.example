# Supabase — public client configuration used by the website and CRM session APIs
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only Supabase key. NEVER expose this as NEXT_PUBLIC_*.
# Required for Meta Lead webhook ingestion.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Meta Lead Ads webhook
META_WEBHOOK_VERIFY_TOKEN=YOUR_META_WEBHOOK_VERIFY_TOKEN
META_LEADS_ACCESS_TOKEN=YOUR_META_LEADS_ACCESS_TOKEN
META_GRAPH_VERSION=v23.0
